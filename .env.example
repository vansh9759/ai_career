# =========================================================================
# CareerOS AI - Production Environment Configuration Template
# =========================================================================

# Flask Secret Key for Session Encryption
SECRET_KEY=production_secure_secret_key_change_me_in_prod

# Managed Database URL (PostgreSQL on Render, Supabase, Neon, or SQLite fallback)
# Format: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///database.db

# Google Gemini AI API Secret Key (Keep server-side only!)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Super Administrator Seed Credentials
ADMIN_EMAIL=admin@careeros.ai
ADMIN_PASSWORD=Admin@12345

# Port Configuration
PORT=5000
FLASK_ENV=production
